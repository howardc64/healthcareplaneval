{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/health-plan.schema.json",
  "title": "Health plan summary (common schema)",
  "description": "One health insurance plan: a marketplace plan (SBC + plan-details page) or a Medicare Advantage plan (Aetna-style plan-details page, Summary of Benefits, EOC). Facts only: record what the documents say, with a short source quote. Anything the documents do not state (for example dollar prices for services charged as coinsurance) is left null here and, if you want the evaluator to use an estimate, goes in evaluator_inputs.prices. Schema 2.1 is backward compatible with 2.0: every 2.0 file is still valid. New in 2.1: plan.identity.plan_category, out-of-network cost shares (plan.out_of_network_services), per-plan Medicare block (plan.medicare), supplemental benefits (dental, vision, hearing, fitness, transportation, meals), Part D drug deductible and out-of-pocket cap, pharmacy channels, and six more services. New in 2.2: dental services costed by the evaluator (plan.services.dental_cleaning, dental_root_canal, dental_crown), plan.limits.dental_deductible, dental_annual_max and dental_preventive_counts_toward_max, and evaluator_inputs.prices.dental_cleaning, dental_root_canal, dental_crown. Every 2.0 and 2.1 file is still valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan"
  ],
  "$defs": {
    "money": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Dollars. null = not stated in the documents."
    },
    "costShare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": {
          "type": "string",
          "enum": [
            "copay",
            "coinsurance",
            "no_charge",
            "not_covered",
            "not_applicable",
            "unknown"
          ],
          "description": "copay = flat dollar amount; coinsurance = percentage of the allowed amount; no_charge = you pay $0; not_covered = excluded; not_applicable = the plan has no such service or tier; unknown = the documents are unclear."
        },
        "copay_amount": {
          "$ref": "#/$defs/money",
          "description": "Flat amount per unit when structure is copay."
        },
        "coinsurance_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "YOUR share in percent (not the plan's share) when structure is coinsurance."
        },
        "deductible_applies": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true = you pay the full allowed amount until the deductible is met, then the copay or coinsurance (documents say 'up to the deductible / $X copay after you meet your deductible'). false = copay or coinsurance applies from the first dollar ('deductible does not apply'). null = not stated."
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "visit",
            "day",
            "prescription",
            "trip",
            "test",
            "stay",
            "item",
            null
          ],
          "description": "What one copay or coinsurance charge covers."
        },
        "max_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Cap on charged units, for example 5 (copays per hospital stay). For dental services it is the number of units the plan covers per person per year, for example 2 cleanings; units above it are not covered and you pay their full price."
        },
        "limits": {
          "type": "string",
          "description": "Coverage limits or exceptions in plain words, for example '25 visits per year'."
        },
        "source_text": {
          "type": "string",
          "maxLength": 300,
          "description": "Short quote from the document that supports this entry."
        }
      },
      "required": [
        "structure"
      ],
      "description": "How you pay for one kind of service."
    },
    "visitCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost_share": {
          "$ref": "#/$defs/costShare",
          "description": "Cost per visit after any discounted first visits."
        },
        "first_visits": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "cost_share": {
                  "$ref": "#/$defs/costShare"
                }
              },
              "required": [
                "count",
                "cost_share"
              ]
            }
          ],
          "description": "Plans that charge less for the first N visits of the year (for example the first 2 visits are $1). null if there is no such rule."
        }
      },
      "required": [
        "cost_share"
      ],
      "description": "A visit type that may have a different price for the first visits of the year."
    },
    "coverageExample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "total_example_cost": {
          "$ref": "#/$defs/money"
        },
        "deductible_paid": {
          "$ref": "#/$defs/money"
        },
        "copayments_paid": {
          "$ref": "#/$defs/money"
        },
        "coinsurance_paid": {
          "$ref": "#/$defs/money"
        },
        "limits_or_exclusions": {
          "$ref": "#/$defs/money"
        },
        "patient_total": {
          "$ref": "#/$defs/money"
        }
      },
      "required": [
        "name"
      ],
      "description": "One SBC coverage example (self-only coverage)."
    },
    "allowanceBenefit": {
      "type": "object",
      "additionalProperties": false,
      "description": "A supplemental Medicare Advantage benefit (dental, vision, hearing, fitness, transportation, meals). Not costed by the evaluator; recorded for comparison.",
      "properties": {
        "covered": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true/false as stated; null if the plan page does not mention it."
        },
        "in_network": {
          "$ref": "#/$defs/costShare"
        },
        "out_of_network": {
          "$ref": "#/$defs/costShare"
        },
        "annual_allowance": {
          "$ref": "#/$defs/money",
          "description": "Dollar allowance, if the benefit is an allowance."
        },
        "allowance_basis": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "per_year",
            "per_ear_per_year",
            "per_item",
            null
          ]
        },
        "frequency_limit": {
          "type": "string",
          "description": "For example 'one exam per calendar year'."
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plain-words list of the benefit lines, for example each dental category and its coinsurance."
        },
        "source_text": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "pharmacyChannel": {
      "type": "object",
      "additionalProperties": false,
      "description": "Drug cost shares at one kind of pharmacy and supply length. tier1..tier5 are positional (Tier N of the plan's own tier list).",
      "required": [
        "channel"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": [
            "preferred_retail",
            "standard_retail",
            "mail_order",
            "other"
          ]
        },
        "days_supply": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tier1": {
          "$ref": "#/$defs/costShare"
        },
        "tier2": {
          "$ref": "#/$defs/costShare"
        },
        "tier3": {
          "$ref": "#/$defs/costShare"
        },
        "tier4": {
          "$ref": "#/$defs/costShare"
        },
        "tier5": {
          "$ref": "#/$defs/costShare"
        },
        "insulin_cap": {
          "$ref": "#/$defs/money"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "serviceMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preventive_care": {
          "$ref": "#/$defs/costShare"
        },
        "primary_care_visit": {
          "$ref": "#/$defs/visitCost"
        },
        "specialist_visit": {
          "$ref": "#/$defs/costShare"
        },
        "urgent_care_visit": {
          "$ref": "#/$defs/costShare"
        },
        "virtual_care_visit": {
          "$ref": "#/$defs/costShare"
        },
        "lab_test": {
          "$ref": "#/$defs/costShare",
          "description": "Diagnostic test: laboratory and professional services (blood work) at an office or lab."
        },
        "xray_diagnostic_imaging": {
          "$ref": "#/$defs/costShare",
          "description": "Diagnostic test: x-ray and diagnostic imaging at an office or imaging center."
        },
        "diagnostic_test_other_place_of_service": {
          "$ref": "#/$defs/costShare",
          "description": "Lab and x-ray billed at hospital, ER or outpatient facility instead of the office."
        },
        "imaging_ct_pet_mri": {
          "$ref": "#/$defs/costShare",
          "description": "Advanced imaging: MRI, PET, CT and ultrasound share this one cost share."
        },
        "outpatient_surgery_facility": {
          "$ref": "#/$defs/costShare"
        },
        "outpatient_surgery_professional": {
          "$ref": "#/$defs/costShare"
        },
        "emergency_room": {
          "$ref": "#/$defs/costShare"
        },
        "emergency_transport": {
          "$ref": "#/$defs/costShare"
        },
        "hospital_facility": {
          "$ref": "#/$defs/costShare",
          "description": "Hospital room and facility fee. Use unit day and max_units for per-day copays."
        },
        "hospital_professional": {
          "$ref": "#/$defs/costShare"
        },
        "mental_health_outpatient_office": {
          "$ref": "#/$defs/visitCost"
        },
        "mental_health_outpatient_other": {
          "$ref": "#/$defs/costShare"
        },
        "mental_health_inpatient": {
          "$ref": "#/$defs/costShare"
        },
        "maternity_office_visit": {
          "$ref": "#/$defs/costShare"
        },
        "delivery_professional": {
          "$ref": "#/$defs/costShare"
        },
        "delivery_facility": {
          "$ref": "#/$defs/costShare"
        },
        "home_health": {
          "$ref": "#/$defs/costShare"
        },
        "rehabilitation_outpatient": {
          "$ref": "#/$defs/costShare"
        },
        "rehabilitation_inpatient": {
          "$ref": "#/$defs/costShare"
        },
        "habilitation_outpatient": {
          "$ref": "#/$defs/costShare"
        },
        "habilitation_inpatient": {
          "$ref": "#/$defs/costShare"
        },
        "skilled_nursing": {
          "$ref": "#/$defs/costShare"
        },
        "durable_medical_equipment": {
          "$ref": "#/$defs/costShare"
        },
        "hospice": {
          "$ref": "#/$defs/costShare"
        },
        "chiropractic": {
          "$ref": "#/$defs/visitCost"
        },
        "children_eye_exam": {
          "$ref": "#/$defs/costShare"
        },
        "children_glasses": {
          "$ref": "#/$defs/costShare"
        },
        "children_dental_checkup": {
          "$ref": "#/$defs/costShare"
        },
        "annual_physical": {
          "$ref": "#/$defs/costShare"
        },
        "diagnostic_procedure": {
          "$ref": "#/$defs/costShare",
          "description": "Diagnostic procedures and tests other than lab, x-ray and advanced imaging (Medicare plans list these separately)."
        },
        "mammogram": {
          "$ref": "#/$defs/costShare"
        },
        "colonoscopy_preventive_diagnostic": {
          "$ref": "#/$defs/costShare",
          "description": "Preventive or diagnostic colonoscopy at an ambulatory surgery center (often $0 on Medicare plans)."
        },
        "diabetic_supplies": {
          "$ref": "#/$defs/costShare",
          "description": "Blood glucose meters and medical diabetic supplies. Put brand rules in limits."
        },
        "continuous_glucose_monitor": {
          "$ref": "#/$defs/costShare"
        },
        "dental_cleaning": {
          "$ref": "#/$defs/costShare",
          "description": "Routine dental cleaning (preventive dental). Medicare Advantage: take it from supplemental_benefits.dental_preventive. Marketplace adult dental is usually excluded: use not_covered."
        },
        "dental_root_canal": {
          "$ref": "#/$defs/costShare",
          "description": "Root canal (endodontic service). Medicare Advantage: take it from supplemental_benefits.dental_comprehensive. Your share of the dentist's charge, before the annual maximum."
        },
        "dental_crown": {
          "$ref": "#/$defs/costShare",
          "description": "Crown (restorative or prosthodontic service). Medicare Advantage: take it from supplemental_benefits.dental_comprehensive."
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0",
        "2.1",
        "2.2"
      ],
      "description": "Use 2.2 for any file that uses a 2.2 field (dental cleaning, root canal and crown cost shares, dental limits, dental prices). Use 2.1 for any file that uses a 2.1 field (all Medicare files)."
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Full plan name as printed, for example 'Ambetter Cascade Select Vital Gold: Standard Gold On Exchange Plan'."
            },
            "carrier": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "plan_year": {
              "type": "string"
            },
            "coverage_start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "coverage_end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "metal_level": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Bronze",
                "Silver",
                "Gold",
                "Platinum",
                "Catastrophic",
                null
              ]
            },
            "plan_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "HMO",
                "PPO",
                "EPO",
                "POS",
                "HDHP",
                "HMO-POS",
                "PFFS",
                null
              ]
            },
            "hsa_eligible": {
              "type": "boolean",
              "description": "As stated on the plan-details page."
            },
            "sbc_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Document id printed at the bottom of the SBC."
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "plan_category": {
              "type": "string",
              "enum": [
                "marketplace",
                "medicare_advantage"
              ],
              "default": "marketplace",
              "description": "Missing = marketplace. medicare_advantage requires the plan.medicare block."
            },
            "plan_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Carrier plan or contract id, for example the Medicare contract-plan id 'H5521-687'."
            },
            "medicare_coverage_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "MA",
                "MAPD",
                null
              ],
              "description": "MA = medical only; MAPD = medical plus Part D drug coverage."
            },
            "service_area": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "type": "string"
                },
                "county": {
                  "type": "string"
                },
                "county_fips": {
                  "type": "string"
                },
                "zip": {
                  "type": "string"
                }
              },
              "description": "Where the quoted premium and benefits apply. Medicare plans vary by county."
            }
          },
          "required": [
            "name",
            "hsa_eligible"
          ]
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "out_of_network_covered": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "false when out-of-network care is not covered (except emergencies)."
            },
            "primary_care_provider_required": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "specialist_referral_required": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "emergency_out_of_network_pays_in_network_rates": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "premium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monthly": {
              "$ref": "#/$defs/money",
              "description": "Monthly premium for the household (marketplace estimate; SBCs do not list it)."
            },
            "estimated_yearly_cost": {
              "$ref": "#/$defs/money",
              "description": "Marketplace 'estimated yearly cost' if shown."
            },
            "note": {
              "type": "string"
            },
            "part_b_premium_continues": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Medicare: true when you must keep paying your Part B premium."
            },
            "part_b_monthly": {
              "$ref": "#/$defs/money",
              "description": "Standard Part B premium for the year, if you want it recorded. Not on a plan page."
            },
            "per_person": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "true when the premium is per enrolled person (Medicare). A couple pays it twice."
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deductible_individual": {
              "$ref": "#/$defs/money"
            },
            "deductible_family": {
              "$ref": "#/$defs/money"
            },
            "deductible_embedded": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "true if each family member must meet the individual deductible until the family total is met."
            },
            "separate_service_deductibles": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "oop_max_individual": {
              "$ref": "#/$defs/money"
            },
            "oop_max_family": {
              "$ref": "#/$defs/money"
            },
            "coinsurance_member_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100,
              "description": "Your general share after the deductible (the SBC coverage examples call it 'Other coinsurance')."
            },
            "not_counted_toward_oop_max": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deductible_out_of_network": {
              "$ref": "#/$defs/money"
            },
            "oop_max_combined_in_and_out_of_network": {
              "$ref": "#/$defs/money",
              "description": "Per person. Medicare PPOs state an in-network maximum and a higher combined maximum."
            },
            "individual_only": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "true when the plan states only per-person amounts and has no family amounts (Medicare). The family amounts stay null."
            },
            "drug_deductible": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "amount": {
                  "$ref": "#/$defs/money"
                },
                "applies_to_tiers": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                },
                "tiers_without_deductible": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  }
                }
              },
              "description": "Part D deductible when it is separate from the medical deductible."
            },
            "drug_oop_max": {
              "$ref": "#/$defs/money",
              "description": "Annual prescription out-of-pocket cap (Part D)."
            },
            "dental_deductible": {
              "$ref": "#/$defs/money",
              "description": "Separate dental deductible, per person (for example the optional Kaiser dental add-on). Null when there is none."
            },
            "dental_annual_max": {
              "$ref": "#/$defs/money",
              "description": "Most the plan pays for dental in a year, per person (the dental benefit amount or allowance). You pay everything above it. Null when the documents state no maximum."
            },
            "dental_preventive_counts_toward_max": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "true when cleanings and other preventive dental count toward dental_annual_max, false when they do not, null when not stated."
            }
          }
        },
        "services": {
          "$ref": "#/$defs/serviceMap",
          "description": "In-network cost shares (the ones the evaluator uses). For Medicare PPOs these are the in-network amounts."
        },
        "drugs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tier1_generic": {
              "$ref": "#/$defs/costShare"
            },
            "tier2_preferred_brand": {
              "$ref": "#/$defs/costShare"
            },
            "tier3_non_preferred_brand": {
              "$ref": "#/$defs/costShare"
            },
            "tier4_specialty": {
              "$ref": "#/$defs/costShare"
            },
            "tier5": {
              "$ref": "#/$defs/costShare",
              "description": "Use not_applicable if the plan has only four tiers."
            },
            "insulin_30_day_cap": {
              "$ref": "#/$defs/money"
            },
            "retail_days_supply": {
              "type": [
                "integer",
                "null"
              ]
            },
            "mail_order_days_supply": {
              "type": [
                "integer",
                "null"
              ]
            },
            "mail_order_cost_multiplier": {
              "type": [
                "number",
                "null"
              ],
              "description": "For example 2.5 = mail order costs 2.5 x the retail copay."
            },
            "tier_labels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "string"
              },
              "description": "The plan's own names for Tier 1 to Tier 5, in order."
            },
            "pharmacy_channels": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pharmacyChannel"
              }
            }
          },
          "description": "tier1_generic .. tier5 are POSITIONAL: each holds Tier 1..Tier 5 of the plan's own tier list, whatever the key name says (Medicare Tier 2 is 'Generic drugs', not 'preferred brand'). Put the plan's best everyday channel (for Medicare, preferred pharmacy retail, 30 days) here and every channel in pharmacy_channels."
        },
        "excluded_services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "other_covered_services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageExample"
          }
        },
        "out_of_network_services": {
          "$ref": "#/$defs/serviceMap",
          "description": "Optional. Cost shares when you use out-of-network providers (PPO and POS plans). Recorded for reference; the evaluator costs in-network use."
        },
        "medicare": {
          "type": "object",
          "additionalProperties": false,
          "description": "Facts that exist only on Medicare Advantage plans. Required when identity.plan_category is medicare_advantage.",
          "properties": {
            "includes_part_d": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "star_rating": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 5,
              "description": "Overall Medicare Star Rating."
            },
            "eligibility_note": {
              "type": "string",
